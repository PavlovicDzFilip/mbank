@page "/projects/{id:guid}"
@model MBank.Api.Pages.Projects.DetailModel
@inject MBank.Api.Services.ServerUrls ServerUrls
@{
    ViewData["Title"] = Model.Project?.Name ?? "Project";
    var tokenCount = Model.Tokens.Count;
    var memoryCount = Model.MemoryCount ?? 0;
}

<main class="app-shell workspace">
    <section class="workspace-frame">
        @if (Model.Project is null)
        {
            <div class="alert alert-error" role="alert">Project not found.</div>
        }
        else
        {
            <header class="workspace-header workspace-header-stack">
                <nav class="breadcrumb" aria-label="Breadcrumb">
                    <a asp-page="/Projects/Index">Projects</a>
                    <span aria-hidden="true">/</span>
                    <span>@Model.Project.Name</span>
                </nav>
                <div class="workspace-title-row">
                    <div>
                        <h1>@Model.Project.Name</h1>
                        <p class="lede">
                            Created @Model.Project.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
                            · @tokenCount token@(tokenCount == 1 ? "" : "s")
                            · @memoryCount memor@(memoryCount == 1 ? "y" : "ies")
                        </p>
                    </div>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <div class="alert alert-error" role="alert">@Model.Error</div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.IssuedToken))
            {
                <div class="alert alert-success token-banner" role="status">
                    <div>
                        <p class="alert-title">Copy this token now.</p>
                        <p class="alert-copy">It will not be shown again. Store it in your MCP client config.</p>
                    </div>
                    <div class="token-banner-code">
                        <code id="issued-token-value">@Model.IssuedToken</code>
                        <button type="button" class="btn btn-ghost btn-sm" data-copy-target="issued-token-value">Copy</button>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.OnboardingGuide) || !string.IsNullOrWhiteSpace(Model.IssuedToken))
            {
                var serverUrl = ServerUrls.GetUrl(Microsoft.AspNetCore.Http.PathString.Empty);
                <section class="workspace-section onboarding-guide" aria-labelledby="agent-setup-title">
                    <div class="section-toolbar">
                        <div>
                            <h2 id="agent-setup-title" class="section-title">Agent setup</h2>
                            <p class="section-copy">Connect this project to Codex, Claude, Cursor, or another MCP client.</p>
                        </div>
                        @if (string.IsNullOrWhiteSpace(Model.IssuedToken))
                        {
                            <button type="button" class="btn btn-primary btn-sm" data-dialog-open="create-token-dialog">New token</button>
                        }
                    </div>

                    @if (string.IsNullOrWhiteSpace(Model.IssuedToken))
                    {
                        <p class="setup-copy">Create a project token first. MBank uses that token to scope agent memory to this project.</p>
                    }
                    else
                    {
                        <p class="setup-copy">Use the token above as <code>MBANK_PROJECT_TOKEN</code>, then add this MCP server to your client:</p>
                        <pre class="setup-code"><code>[mcp_servers.mbank]
enabled = true
url = "@(ServerUrls.GetUrl("/mcp"))"
bearer_token_env_var = "MBANK_PROJECT_TOKEN"</code></pre>
                    }

                    <div class="setup-grid">
                        <div>
                            <h3>macOS or Linux</h3>
                            <pre class="setup-code"><code>curl -fsSL "@(ServerUrls.GetUrl("/bootstrap-agent.sh"))" -o bootstrap-agent.sh
sh bootstrap-agent.sh --server-url "@serverUrl"</code></pre>
                        </div>
                        <div>
                            <h3>Windows PowerShell</h3>
                            <pre class="setup-code"><code>Invoke-WebRequest "@(ServerUrls.GetUrl("/bootstrap-agent.ps1"))" -OutFile bootstrap-agent.ps1
.\bootstrap-agent.ps1 -ServerUrl "@serverUrl"</code></pre>
                        </div>
                    </div>
                </section>
            }

            <section class="workspace-section">
                <div class="section-toolbar">
                    <div>
                        <h2 class="section-title">Memories</h2>
                        <p class="section-copy">Read-only inspection of what MBank stored for this project.</p>
                    </div>
                    <a class="btn btn-primary btn-sm" asp-page="/Projects/Memories/Index" asp-route-id="@Model.Project.Id.Value">View memories</a>
                </div>
                @if (memoryCount == 0)
                {
                    <p class="empty-inline">No memories yet. Agents write via MCP.</p>
                }
            </section>

            <section class="workspace-section">
                <div class="section-toolbar">
                    <div>
                        <h2 class="section-title">Access tokens</h2>
                        <p class="section-copy">MCP credentials scoped to you and this project.</p>
                    </div>
                    <button type="button" class="btn btn-primary btn-sm" data-dialog-open="create-token-dialog">New token</button>
                </div>

                @if (Model.Tokens.Count == 0)
                {
                    <p class="empty-inline">No tokens yet.</p>
                }
                else
                {
                    <ul class="data-list data-list-dense">
                        @foreach (var token in Model.Tokens)
                        {
                            var deleteDialogId = $"delete-token-{token.Id.Value}";
                            <li class="token-item">
                                <div class="token-item-main">
                                    <span class="data-row-title">@token.Name</span>
                                    <span class="token-mask">@token.TokenPrefix&hellip;@token.TokenSuffix</span>
                                </div>
                                <span class="token-item-meta">@token.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                                <button type="button" class="btn btn-ghost btn-sm" data-dialog-open="@deleteDialogId">Delete</button>
                                <dialog id="@deleteDialogId" class="app-dialog">
                                    <form method="post" asp-page-handler="DeleteToken" class="dialog-form">
                                        <input type="hidden" name="tokenId" value="@token.Id.Value" />
                                        <div class="dialog-head">
                                            <h2>Delete token?</h2>
                                            <p class="dialog-copy">
                                                <strong>@token.Name</strong> will be removed permanently. MCP clients using it will stop working immediately.
                                            </p>
                                        </div>
                                        <div class="dialog-actions">
                                            <button type="button" class="btn btn-ghost" data-dialog-close>Cancel</button>
                                            <button type="submit" class="btn btn-danger">Delete</button>
                                        </div>
                                    </form>
                                </dialog>
                            </li>
                        }
                    </ul>
                }
            </section>

            <details class="disclosure" @(Model.OpenSettings ? "open" : null)>
                <summary>Project settings</summary>
                <div class="disclosure-body">
                    <form method="post" asp-page-handler="Rename" class="inline-form-stack">
                        <label class="field-label" asp-for="Name">Display name</label>
                        <div class="inline-field-row">
                            <input asp-for="Name" autocomplete="off" />
                            <button type="submit" class="btn btn-primary btn-sm">Save</button>
                        </div>
                    </form>
                </div>
            </details>

            <details class="disclosure disclosure-danger">
                <summary>Danger zone</summary>
                <div class="disclosure-body">
                    <p class="section-copy">Permanently deletes this project, its tokens, and all stored memories.</p>
                    <button type="button" class="btn btn-danger btn-sm" data-dialog-open="delete-project-dialog">Delete project</button>
                </div>
            </details>

            <dialog id="create-token-dialog" class="app-dialog" @(Model.OpenCreateTokenDialog ? "data-show-on-load" : null)>
                <form method="post" asp-page-handler="CreateToken" class="dialog-form">
                    <div class="dialog-head">
                        <h2>New access token</h2>
                        <p class="dialog-copy">Use a descriptive name so you can tell tokens apart later.</p>
                    </div>
                    <label class="field-label" asp-for="TokenName">Name</label>
                    <input asp-for="TokenName" autocomplete="off" placeholder="Codex repo token" />
                    <div class="dialog-actions">
                        <button type="button" class="btn btn-ghost" data-dialog-close>Cancel</button>
                        <button type="submit" class="btn btn-primary">Create token</button>
                    </div>
                </form>
            </dialog>

            <dialog id="delete-project-dialog" class="app-dialog">
                <form method="post" asp-page-handler="Delete" class="dialog-form">
                    <div class="dialog-head">
                        <h2>Delete project?</h2>
                        <p class="dialog-copy">
                            This permanently deletes <strong>@Model.Project.Name</strong> and everything inside it.
                        </p>
                    </div>
                    <div class="dialog-actions">
                        <button type="button" class="btn btn-ghost" data-dialog-close>Cancel</button>
                        <button type="submit" class="btn btn-danger">Delete project</button>
                    </div>
                </form>
            </dialog>
        }
    </section>
</main>
