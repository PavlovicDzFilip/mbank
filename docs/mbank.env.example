# Copy to the production server as /vault/mbank.env (never commit real values).
# Image tags are set at deploy time via MBANK_VERSION, not in this file.

ConnectionStrings__MemoryDb=Host=...;Port=5432;Database=mbank;Username=...;Password=...;

OpenAI__ApiKey=
OpenAI__EmbeddingModel=text-embedding-3-small
OpenAI__EmbeddingDimensions=1536

Smtp__Host=
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=MBank

MagicLink__PublicBaseUrl=https://mbank.engineeringwithfilip.com
